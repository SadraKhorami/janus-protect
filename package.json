{
  "name": "janus-protect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @janus/database generate",
    "db:validate": "pnpm --filter @janus/database validate",
    "db:migrate": "pnpm --filter @janus/database migrate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "turbo": "2.10.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
