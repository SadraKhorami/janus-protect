generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum ProjectType {
  UNKNOWN
  PLUGIN
  THEME
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProtectionLevel {
  BASIC
  STANDARD
  STRONG
}

enum BuildStatus {
  QUEUED
  PREPARING
  ANALYZING
  INJECTING_RUNTIME
  PROTECTING
  GENERATING_INTEGRITY
  VALIDATING
  PACKAGING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum BuildArtifactKind {
  ORIGINAL_SOURCE
  PROTECTED_ZIP
  ANALYSIS_REPORT
  PROTECTION_REPORT
  INTEGRITY_MANIFEST
  BUILD_REPORT
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(254)
  username        String      @unique @db.VarChar(32)
  passwordHash    String      @db.VarChar(255)
  status          UserStatus  @default(UNVERIFIED)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  authSessions       AuthSession[]
  memberships        OrganizationMember[]
  auditLogs          AuditLog[]              @relation("AuditActor")

  @@index([status])
}

model EmailVerification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  codeHash     String    @db.VarChar(64)
  expiresAt    DateTime
  attemptCount Int       @default(0)
  resendCount  Int       @default(0)
  lastSentAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(64)
  userAgent         String?   @db.VarChar(512)
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  auditLogs AuditLog[]
  projects  Project[]
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String   @db.VarChar(100)
  resourceType   String   @db.VarChar(100)
  resourceId     String?  @db.VarChar(100)
  requestId      String?  @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime @default(now())

  actor       User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String        @db.VarChar(100)
  slug           String        @db.VarChar(80)
  type           ProjectType   @default(UNKNOWN)
  status         ProjectStatus @default(ACTIVE)
  description    String?       @db.VarChar(1000)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources         ProjectSource[]
  protection      ProtectionProfile?
  builds          Build[]
  licenses        License[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, createdAt])
}

model License {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @db.Uuid
  keyHash        String        @unique @db.Char(64)
  keyPrefix      String        @db.VarChar(16)
  customerEmail  String?       @db.VarChar(254)
  maxActivations Int           @default(1)
  status         LicenseStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activations LicenseActivation[]

  @@index([projectId, status, createdAt])
}

model LicenseActivation {
  id              String    @id @default(uuid()) @db.Uuid
  licenseId       String    @db.Uuid
  siteUrl         String    @db.VarChar(512)
  siteHash        String    @db.Char(64)
  tokenHash       String    @unique @db.Char(64)
  activatedAt     DateTime  @default(now())
  lastValidatedAt DateTime  @default(now())
  deactivatedAt   DateTime?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, siteHash])
  @@index([licenseId, deactivatedAt])
}

model ProjectSource {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  revision         Int
  originalObjectKey String     @unique @db.VarChar(512)
  sha256           String      @db.Char(64)
  size             Int
  fileCount        Int
  uncompressedSize Int
  detectedType     ProjectType
  rootDirectory    String      @db.VarChar(255)
  analysis         Json
  createdAt        DateTime    @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builds    Build[]

  @@unique([projectId, revision])
  @@index([projectId, createdAt])
}

model ProtectionProfile {
  projectId        String          @id @db.Uuid
  level            ProtectionLevel @default(BASIC)
  runtimeInjection Boolean         @default(true)
  integrity        Boolean         @default(true)
  obfuscation      Boolean         @default(true)
  excludePaths     String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Build {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @db.Uuid
  sourceId        String          @db.Uuid
  version         String          @db.VarChar(32)
  protectionLevel ProtectionLevel
  runtimeInjection Boolean        @default(true)
  integrity        Boolean        @default(true)
  obfuscation      Boolean        @default(true)
  excludePaths     String[]
  status          BuildStatus     @default(QUEUED)
  errorCode       String?         @db.VarChar(100)
  errorMessage    String?         @db.VarChar(1000)
  queuedAt        DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    ProjectSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  artifacts BuildArtifact[]

  @@unique([projectId, version])
  @@index([projectId, status, createdAt])
  @@index([status, queuedAt])
}

model BuildArtifact {
  id          String            @id @default(uuid()) @db.Uuid
  buildId     String            @db.Uuid
  kind        BuildArtifactKind
  objectKey   String            @unique @db.VarChar(512)
  sha256      String            @db.Char(64)
  size        Int
  contentType String            @db.VarChar(100)
  createdAt   DateTime          @default(now())

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, kind])
  @@index([buildId])
}
