{
  "name": "@janus/database",
  "version": "0.2.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "lint": "eslint src",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "node prisma/seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "argon2": "0.44.0"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "prisma": "6.14.0",
    "vitest": "3.2.4"
  }
}
