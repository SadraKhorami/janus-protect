{
  "name": "@janus/worker-build",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@janus/config": "workspace:*",
    "@janus/contracts": "workspace:*",
    "@janus/database": "workspace:*",
    "@janus/logger": "workspace:*",
    "@janus/protection-core": "workspace:*",
    "@janus/queue": "workspace:*",
    "@janus/storage": "workspace:*",
    "bullmq": "5.58.0",
    "pino": "9.9.0"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "vitest": "3.2.4"
  }
}
